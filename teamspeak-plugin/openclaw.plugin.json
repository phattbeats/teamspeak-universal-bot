{
  "id": "teamspeak",
  "name": "TeamSpeak",
  "description": "OpenClaw TeamSpeak channel plugin: realtime voice in a TeamSpeak channel over the plnt-ts-bridge sidecar.",
  "activation": {
    "onStartup": false
  },
  "channels": [
    "teamspeak"
  ],
  "channelConfigs": {
    "teamspeak": {
      "label": "TeamSpeak",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bridgeUrl": { "type": "string" },
          "channel": { "type": "string" },
          "commandPrefix": { "type": "string" },
          "commandAllowFrom": { "type": "array", "items": { "type": "number" } },
          "voice": { "type": "object", "additionalProperties": true },
          "tools": { "type": "object", "additionalProperties": true }
        }
      },
      "uiHints": {
        "bridgeUrl": {
          "label": "Bridge URL",
          "placeholder": "ws://ts-bridge:9099"
        },
        "channel": {
          "label": "Channel",
          "placeholder": "General"
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "contracts": {
    "tools": [
      "play_music",
      "stop_music",
      "set_volume",
      "what_did_i_miss",
      "who_is_here",
      "poke",
      "leave_voice",
      "join_voice",
      "compose_song",
      "band_status",
      "song_lyrics",
      "replay_song",
      "now_playing",
      "show_queue",
      "skip",
      "remove_from_queue",
      "move_in_queue",
      "clear_queue",
      "search_music",
      "play_source",
      "pause",
      "resume",
      "seek",
      "kick_client",
      "move_client",
      "ban_client",
      "unban_client",
      "list_bans",
      "mute_client",
      "edit_channel",
      "create_channel",
      "delete_channel",
      "edit_server",
      "add_to_server_group",
      "list_channels",
      "move_to_channel",
      "where_is",
      "send_text",
      "show_persona",
      "edit_persona",
      "set_voice",
      "set_wake_names",
      "set_follow_up_window"
    ]
  }
}
