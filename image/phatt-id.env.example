# Copy next to your real .env; values here are public (no secrets).

# ── PHATT ID (Authentik on vps1), PHA-4973 (2026-11-08) ─────────────────────────
# Provider "teamspeak" in https://auth.phatt.vip. Verify tokens against the JWKS (RS256, kid rotates by
# re-fetch), check iss + aud. The client secret is NOT here: it lives only in the host's real .env,
# handed over from vps1 /root/pha4973/secrets/teamspeak.oidc.env (root only).
OIDC_ISSUER=https://auth.phatt.vip/application/o/teamspeak/
OIDC_JWKS_URL=https://auth.phatt.vip/application/o/teamspeak/jwks/
OIDC_CLIENT_ID=teamspeak
# OIDC_CLIENT_SECRET=   (never commit)
OIDC_REDIRECT_URI=https://arcade.phatt.vip/link/teamspeak/callback
OIDC_SCOPES="openid profile phatt_type"
